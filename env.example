# Datos de tu proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-o-service-role

# Nombre exacto de tu tabla de reservas en Supabase
RESERVATIONS_TABLE=reservas

# Tu número de WhatsApp (el del dueño), con código de país, sin +, sin espacios
# Ejemplo: si tu número es +53 5 8123456, se escribe:
OWNER_NUMBER=5358123456@s.whatsapp.net
